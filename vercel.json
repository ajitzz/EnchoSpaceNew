{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "images": {
    "sizes": [
      320,
      640,
      768,
      1024,
      1536,
      2048
    ],
    "domains": [
      "s3.amazonaws.com",
      "images.unsplash.com"
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "**"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/terms-of-service/",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/stay/:slug",
      "destination": "/api/seo?type=stay&slug=$slug"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/seo?type=listing&id=$id"
    },
    {
      "source": "/listings/:id",
      "destination": "/api/seo?type=listing&id=$id"
    },
    {
      "source": "/experience/:id",
      "destination": "/api/seo?type=experience&id=$id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rewarm",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "installCommand": "npm ci --include=dev"
}
