# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim AS builder
WORKDIR /app
ENV HUSKY=0
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM node:24.21.0-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production DISABLE_BACKGROUND_WORKERS=true HARVO_HOLD_SWEEPER_ENABLED=true HUSKY=0
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=builder --chown=node:node /app/build/server ./build/server
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node build/server/src/server/deployment/workerHealthcheck.js
STOPSIGNAL SIGTERM
CMD ["node", "build/server/src/server/marketing/worker.js"]
